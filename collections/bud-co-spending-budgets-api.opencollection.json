              "accessTokenUrl": "/v1/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Create a spending budget.\n"
        },
        {
          "info": {
            "name": "Delete all Spending Budgets",
            "type": "http"
