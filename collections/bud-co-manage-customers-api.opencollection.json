            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/v1/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "This endpoint is used to delete an existing Customer. Calling this deletes all data associated with the customer including any Open Banking Consents.\n\nIf the customer with the given ID does not exist or has already been deleted, a 404 error is returned.\n"
        },
